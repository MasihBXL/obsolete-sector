# ==============================================================================
# OBSOLETE SECTOR // CONFIGURATION & OAUTH CREDENTIALS
# ==============================================================================

# Server Port and Base URL
PORT=3000
ADMIN_PASSWORD=1986
# When deployed on Render, set this to your Render URL (e.g. https://obsolete-sector.onrender.com)
BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. REAL GOOGLE OAUTH 2.0 (Google Cloud Console)
# ------------------------------------------------------------------------------
# 1. Go to: https://console.cloud.google.com/apis/credentials
# 2. Click "Create Credentials" -> "OAuth client ID" -> "Web application"
# 3. Add Authorized redirect URIs:
#    - For local development: http://localhost:3000/api/auth/google/callback
#    - For production / Render: https://YOUR_APP.onrender.com/api/auth/google/callback
# 4. Copy Client ID and Client Secret below:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 2. REAL GITHUB OAUTH (GitHub Developer Settings)
# ------------------------------------------------------------------------------
# 1. Go to: https://github.com/settings/developers -> "OAuth Apps" -> "New OAuth App"
# 2. Set Homepage URL: http://localhost:3000 (or your Render URL)
# 3. Set Authorization callback URL:
#    - For local: http://localhost:3000/api/auth/github/callback
#    - For production: https://YOUR_APP.onrender.com/api/auth/github/callback
# 4. Copy Client ID and Client Secret below:
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 3. APPLE SIGN IN (Requires Apple Developer Program $99/yr)
# ------------------------------------------------------------------------------
# APPLE_CLIENT_ID=com.example.service
# APPLE_TEAM_ID=XXXXXXXXXX
# APPLE_KEY_ID=XXXXXXXXXX
